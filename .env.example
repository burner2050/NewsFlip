# --- Database ---
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgres://newsflip:newsflip@localhost:5432/newsflip

# --- Web server ---
HOST=0.0.0.0
PORT=3000

# --- Ingestion ---
# How often the worker polls feeds (cron expression). Default: every 15 min.
INGEST_CRON=*/15 * * * *
# Per-request fetch timeout (ms)
FETCH_TIMEOUT_MS=15000
# Near-duplicate simhash Hamming-distance threshold (0-64). Lower = stricter.
DEDUP_HAMMING_THRESHOLD=3
# Look-back window for near-dup comparison (hours)
DEDUP_WINDOW_HOURS=72

# --- AI providers (phase 2) ---
# Pluggable. One of: stub | anthropic | openai | ollama
AI_PROVIDER=stub
EMBEDDING_PROVIDER=stub
EMBEDDING_DIM=384
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

LOG_LEVEL=info
