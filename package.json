{
  "name": "newsflip",
  "version": "0.1.0",
  "private": true,
  "description": "A news aggregator: RSS ingest, dedup, story clustering, fact extraction, summaries, search and alerts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/web/server.ts",
    "start": "node dist/web/server.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^7.4.0",
    "@fastify/static": "^7.0.4",
    "@fastify/view": "^9.1.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "rss-parser": "^3.13.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
