<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' · NewsFlip' : 'NewsFlip' %></title>
  <script src="https://unpkg.com/htmx.org@1.9.12" integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2" crossorigin="anonymous"></script>
  <style>
    :root { --fg:#1a1a1a; --muted:#6b7280; --bg:#fafafa; --card:#fff; --accent:#2563eb; --border:#e5e7eb; }
    * { box-sizing: border-box; }
    body { margin:0; font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; color:var(--fg); background:var(--bg); }
    header { background:var(--card); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:10; }
    .bar { max-width:860px; margin:0 auto; padding:12px 16px; display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
    .brand { font-weight:700; font-size:20px; color:var(--fg); text-decoration:none; }
    .brand span { color:var(--accent); }
    nav a { color:var(--muted); text-decoration:none; margin-right:14px; font-size:14px; }
    nav a.active, nav a:hover { color:var(--accent); }
    main { max-width:860px; margin:0 auto; padding:20px 16px 60px; }
    .search { margin-left:auto; }
    .search input { padding:7px 11px; border:1px solid var(--border); border-radius:8px; width:220px; font-size:14px; }
    h1 { font-size:22px; margin:0 0 16px; }
    .card { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:14px 16px; margin-bottom:12px; }
    .card h2 { font-size:17px; margin:0 0 6px; line-height:1.35; }
    .card h2 a { color:var(--fg); text-decoration:none; }
    .card h2 a:hover { color:var(--accent); }
    .meta { color:var(--muted); font-size:13px; margin-bottom:8px; }
    .meta a { color:var(--muted); }
    .excerpt { color:#374151; font-size:14.5px; margin:0; }
    mark { background:#fef08a; padding:0 1px; }
    .pager { display:flex; gap:10px; justify-content:center; margin-top:18px; }
    .btn { display:inline-block; padding:7px 14px; border:1px solid var(--border); border-radius:8px; background:var(--card); color:var(--fg); text-decoration:none; font-size:14px; cursor:pointer; }
    .btn:hover { border-color:var(--accent); color:var(--accent); }
    .empty { color:var(--muted); padding:30px 0; text-align:center; }
    table { width:100%; border-collapse:collapse; font-size:14px; }
    th,td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--border); }
    form.inline { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
    form.inline input { padding:8px 11px; border:1px solid var(--border); border-radius:8px; font-size:14px; }
    .ok { color:#15803d; } .err { color:#b91c1c; }
    article.full { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:22px 24px; }
    article.full .body { white-space:pre-wrap; margin-top:14px; }
  </style>
</head>
<body>
  <header>
    <div class="bar">
      <a class="brand" href="/">News<span>Flip</span></a>
      <nav>
        <a href="/" class="<%= active==='home' ? 'active' : '' %>">Latest</a>
        <a href="/search" class="<%= active==='search' ? 'active' : '' %>">Search</a>
        <a href="/alerts" class="<%= active==='alerts' ? 'active' : '' %>">Alerts</a>
        <a href="/sources" class="<%= active==='sources' ? 'active' : '' %>">Sources</a>
      </nav>
      <form class="search" action="/search" method="get">
        <input type="search" name="q" placeholder="Search news…" value="<%= typeof q !== 'undefined' ? q : '' %>" />
      </form>
    </div>
  </header>
  <main>
    <%- body %>
  </main>
</body>
</html>
